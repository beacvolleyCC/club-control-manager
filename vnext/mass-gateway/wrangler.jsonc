{
  // Isolated TEST-only API Worker. Not the existing Manager/Player PWA.
  "name": "cc-mass-gateway-test-beac",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "TEST_ONLY": "true",
    "SUPABASE_URL": "https://szzoubvhlwnojtzqjebc.supabase.co",
    "ALLOWED_ORIGIN": "https://cc-player-test-beac.elteroplabda.workers.dev",
    "TURNSTILE_EXPECTED_HOSTNAME": "cc-player-test-beac.elteroplabda.workers.dev",
    "PUBLIC_WRITES_ENABLED": "false",
    "EMAIL_VERIFICATION_ENABLED": "false",
    "EMAIL_DELIVERY_ENABLED": "false"
  },
  "secrets": {
    "required": [
      "SUPABASE_TEST_SECRET_KEY",
      "TURNSTILE_SECRET",
      "EMAIL_PROOF_SECRET",
      "EMAIL_OTP_PEPPER",
      "RESEND_TEST_API_KEY",
      "TEST_EMAIL_FROM",
      "TEST_ALLOWED_EMAIL"
    ]
  },
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "10421", "simple": { "limit": 12, "period": 60 } },
    { "name": "IDENTITY_LIMITER", "namespace_id": "10422", "simple": { "limit": 5, "period": 60 } }
  ]
}
